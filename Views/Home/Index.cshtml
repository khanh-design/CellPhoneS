@model IEnumerable<CPhoneS.Models.SanPham>
@{
    ViewData["Title"] = "Trang chủ";
    var phones = Model.Where(x => x.MaDm == 1);
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

<!-- ================= HERO SLIDER ================= -->
<div id="heroCarousel" class="carousel slide mb-5" data-bs-ride="carousel" data-bs-interval="4000">
    <div class="carousel-inner">

        <div class="carousel-item active">
            <img src="https://happyphone.vn/wp-content/uploads/2024/09/Can-canh-camera-iPhone-16-Pro_Pro-Max.jpg"
                 class="d-block w-100 hero-img">
            <div class="carousel-caption text-start">
                <h1 class="fw-bold">Camera đỉnh cao</h1>
                <p>iPhone 16 Pro – Ghi lại mọi khoảnh khắc</p>
            </div>
        </div>

        <div class="carousel-item">
            <img src="https://cdn.tgdd.vn/Files/2015/10/09/717415/chup-dep.jpg"
                 class="d-block w-100 hero-img">
            <div class="carousel-caption">
                <h1 class="fw-bold">Hình ảnh sắc nét</h1>
                <p>Công nghệ camera tiên tiến</p>
            </div>
        </div>

        <div class="carousel-item">
            <img src="https://tiki.vn/blog/wp-content/uploads/2023/11/top-10-dien-thoai-chup-anh-dep-thumb.jpg"
                 class="d-block w-100 hero-img">
            <div class="carousel-caption text-end">
                <h1 class="fw-bold">Thiết kế thời thượng</h1>
                <p>Đẳng cấp – Sang trọng – Hiện đại</p>
            </div>
        </div>

    </div>
</div>

<!-- ================= INTRO ================= -->
<section class="container mb-5 text-center">
    <img src="https://www.appleinforma.com/wp-content/uploads/2012/11/logo-apple-actual.jpg"
         style="width:180px" class="mb-3" />
    <h2 class="fw-bold">Điện thoại chính hãng</h2>
    <p class="text-muted mt-3">
        Chúng tôi cung cấp các dòng smartphone mới nhất từ Apple, Samsung, Xiaomi, Oppo...
        Cam kết chính hãng – Giá tốt – Hỗ trợ tận tâm.
    </p>
</section>

<!-- ================= PRODUCT LIST ================= -->
<section class="container-fluid bg-white py-5">
    <div class="container">

        <div class="text-center mb-5">
            <h3 class="fw-bold">🔥 Sản phẩm nổi bật</h3>
            <p class="text-muted mt-2">
                Những dòng điện thoại bán chạy và được yêu thích nhất
            </p>
        </div>

        <div class="row g-4 justify-content-center">
            @foreach (var item in phones)
            {
                <div class="col-xl-3 col-lg-4 col-md-6 col-sm-10">
                    <div class="card product-card h-100">

                        <img src="@item.AnhSp" class="card-img-top product-img" />

                        <div class="card-body text-center d-flex flex-column">
                            <h6 class="fw-semibold mb-2">
                                <a asp-action="Details"
                                   asp-route-id="@item.MaSp"
                                   asp-controller="SanPham"
                                   class="text-decoration-none text-dark">
                                    @item.TenSp
                                </a>
                            </h6>

                            <p class="text-danger fw-bold mb-3">
                                @item.GiaSp.ToString("#,##0") VNĐ
                            </p>

                            <a asp-action="Details"
                               asp-route-id="@item.MaSp"
                               asp-controller="SanPham"
                               class="btn btn-outline-primary btn-sm mt-auto">
                                Xem chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</section>


<!-- ================= MAP + CONTACT ================= -->
<section class="container my-5">
    <div class="row g-5 align-items-center">

        <div class="col-lg-6">
            <div class="map-wrapper shadow rounded">
                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d59610.270997895204!2d105.69508552551268!3d20.966889751065047!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x313453d2707de6d5%3A0x2d1813749b94425b!2sCellphoneS!5e0!3m2!1svi!2s!4v1768269494773!5m2!1svi!2s" 
                width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" 
                referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
        </div>

        <div class="col-lg-6">
            <h3 class="fw-bold mb-4">📞 Liên hệ</h3>
            <p><strong>Địa chỉ:</strong> Hà Nội, Việt Nam</p>
            <p><strong>Hotline:</strong> 0123 456 789</p>
            <p><strong>Hỗ trợ:</strong> 0987 654 321</p>
            <p><strong>Email:</strong> support@cphones.vn</p>
        </div>

    </div>
</section>


<!-- ================= CONTACT FORM ================= -->
<section class="bg-light py-5">
    <div class="container">
        <div class="row g-4">

            <div class="col-md-6">
                <h4 class="fw-bold mb-3">Gửi liên hệ</h4>
                <form>
                    <input class="form-control mb-3" placeholder="Tên của bạn">
                    <input class="form-control mb-3" placeholder="Email">
                    <textarea class="form-control mb-3" rows="4" placeholder="Nội dung"></textarea>
                    <button class="btn btn-primary w-100">Gửi</button>
                </form>
            </div>

            <div class="col-md-6">
                <h4 class="fw-bold mb-3">Mạng xã hội</h4>
                <ul class="list-unstyled">
                    <li>📘 Facebook: CPhoneS</li>
                    <li>📸 Instagram: CPhoneS</li>
                    <li>🐦 Twitter: CPhoneS</li>
                    <li>💬 Zalo: CPhoneS</li>
                </ul>

                <h5 class="fw-bold mt-4">⏰ Giờ làm việc</h5>
                <p>Thứ 2 – Thứ 6: 8:00 – 18:00</p>
                <p>Thứ 7: 8:00 – 12:00</p>
                <p>Chủ nhật: Nghỉ</p>
            </div>

        </div>
    </div>
</section>

<!-- ================= CSS ================= -->
<style>
    /* PRODUCT */
    .product-card {
        border-radius: 14px;
        transition: all .3s ease;
    }

        .product-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px rgba(0,0,0,.1);
        }

    .product-img {
        height: 240px;
        object-fit: contain;
        padding: 20px;
    }

    /* MAP FIX */
    .map-wrapper {
        position: relative;
        width: 100%;
        padding-bottom: 56.25%; /* 16:9 */
        overflow: hidden;
        border-radius: 14px;
    }

        .map-wrapper iframe {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border: 0;
        }
</style>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

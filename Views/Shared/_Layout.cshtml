@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - CPhoneS</title>

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- FontAwesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            color: #0f172a;
        }

        /* HEADER */
        .navbar {
            background-color: #1e293b;
        }

        .navbar-brand, .nav-link {
            color: #fff !important;
            font-weight: 500;
        }

            .nav-link:hover {
                color: #60a5fa !important;
            }

        /* CARD */
        .card {
            border: none;
            border-radius: 14px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.06);
        }

        /* BUTTON */
        .btn-primary {
            background-color: #2563eb;
            border: none;
            border-radius: 10px;
        }

            .btn-primary:hover {
                background-color: #1d4ed8;
            }

        /* FOOTER */
        footer {
            background: #1e293b;
            color: #fff;
            padding: 20px 0;
            margin-top: 60px;
        }

        /* CHAT */
        .chat-icon {
            position: fixed;
            bottom: 25px;
            right: 25px;
            background: #2563eb;
            color: white;
            padding: 14px;
            border-radius: 50%;
            font-size: 22px;
            cursor: pointer;
            z-index: 999;
        }

        .chat-box {
            position: fixed;
            bottom: 90px;
            right: 25px;
            width: 320px;
            height: 420px;
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
            display: none;
            flex-direction: column;
            z-index: 998;
        }

        .chat-header {
            background: #2563eb;
            color: white;
            padding: 12px;
            border-radius: 16px 16px 0 0;
            font-weight: 600;
        }

        .chat-body {
            flex: 1;
            padding: 10px;
            overflow-y: auto;
        }

        .chat-footer {
            display: flex;
            padding: 10px;
            gap: 8px;
        }

            .chat-footer input {
                flex: 1;
                border-radius: 8px;
                border: 1px solid #ddd;
                padding: 8px;
            }
    </style>
</head>

<body>

    @{
        var userName = Context.Session.GetString("UserName");
    }

    <!-- HEADER -->
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">📱 CPhoneS</a>

            <button class="navbar-toggler bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="menu">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="SanPham" asp-action="Index">Sản phẩm</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">Dịch vụ</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">Liên hệ</a></li>
                </ul>

                <ul class="navbar-nav align-items-center">
                    <li class="nav-item me-3">
                        <a class="nav-link" asp-controller="Cart" asp-action="Index">
                            <i class="fa fa-shopping-cart"></i>
                        </a>
                    </li>

                    @if (!string.IsNullOrEmpty(userName))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                                @userName
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="Orders" asp-action="MyOrders">Đơn hàng</a></li>
                                <li><hr /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button class="dropdown-item text-danger">Đăng xuất</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn btn-primary ms-2" asp-controller="Account" asp-action="Login">Đăng nhập</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- MAIN -->
    <div class="container my-5">
        @RenderBody()
    </div>

    <!-- FOOTER -->
    <footer class="text-center">
        <p class="mb-0">© 2024 CPhoneS. All rights reserved.</p>
    </footer>

    <!-- CHAT -->
    <div class="chat-icon" onclick="toggleChat()">
        <i class="fa fa-comment"></i>
    </div>

    <div class="chat-box" id="chatBox">
        <div class="chat-header">Hỗ trợ khách hàng</div>
        <div class="chat-body"></div>
        <div class="chat-footer">
            <input placeholder="Nhập tin nhắn..." />
            <button class="btn btn-primary">Gửi</button>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleChat() {
            const box = document.getElementById("chatBox");
            box.style.display = box.style.display === "flex" ? "none" : "flex";
        }
    </script>

    @RenderSection("Scripts", false)
</body>
</html>
@model IEnumerable<CPhoneS.Models.Order>

@{
    ViewData["Title"] = "Danh sách đơn hàng";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <div class="card-body">

            <h4 class="mb-3 text-primary fw-bold">
                Danh sách đơn hàng
            </h4>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Mã đơn</th>
                            <th>Khách hàng</th>
                            <th>Ngày đặt</th>
                            <th class="text-end">Tổng tiền</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-center">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td class="fw-semibold">#@order.OrderId</td>
                                <td>@order.CustomerName</td>
                                <td>
                                    @order.OrderDate.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td class="text-end">
                                    @order.TotalAmount.ToString("N0") ₫
                                </td>

                                <!-- Trạng thái -->
                                <td class="text-center">
                                    @{
                                        string badgeClass = order.Status switch
                                        {
                                            "Pending" => "bg-warning text-dark",
                                            "Completed" => "bg-success",
                                            "Cancelled" => "bg-danger",
                                            _ => "bg-secondary"
                                        };
                                    }
                                    <span class="badge @badgeClass">
                                        @order.Status
                                    </span>
                                </td>

                                <!-- Hành động -->
                                <td class="text-center">
                                    <a class="btn btn-sm btn-outline-primary"
                                       href="@Url.Action("Details", "Orders", new { id = order.OrderId })">
                                        <i class="fa fa-eye"></i> Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }

                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    Không có đơn hàng nào
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>

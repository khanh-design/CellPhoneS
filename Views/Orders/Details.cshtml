@model CPhoneS.Models.Order

@{
    ViewData["Title"] = $"Chi tiết đơn hàng #{Model.OrderId}";
    var orderDetails = ViewBag.OrderDetails as IEnumerable<CPhoneS.Models.OrderDetail>;
}

<div class="container mt-4">

    <!-- Thông tin đơn hàng -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <h4 class="mb-3 text-primary fw-bold">
                Chi tiết đơn hàng @Model.OrderId
            </h4>

            <div class="row">
                <div class="col-md-6">
                    <p><strong>Khách hàng:</strong> @Model.CustomerName</p>
                    <p><strong>Địa chỉ:</strong> @Model.CustomerAddress</p>
                </div>

                <div class="col-md-6">
                    <p><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                    <p>
                        <strong>Trạng thái:</strong>
                        @{
                            string badgeClass = Model.Status switch
                            {
                                "Pending" => "bg-warning text-dark",
                                "Processing" => "bg-info",
                                "Completed" => "bg-success",
                                "Cancelled" => "bg-danger",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @badgeClass">@Model.Status</span>
                    </p>
                    <p class="fw-bold fs-5 text-danger">
                        Tổng tiền: @Model.TotalAmount.ToString("N0") ₫
                    </p>
                </div>
            </div>

        </div>
    </div>

    <!-- Danh sách sản phẩm -->
    <div class="card shadow-sm border-0">
        <div class="card-body">

            <h5 class="mb-3">Danh sách sản phẩm</h5>

            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Sản phẩm</th>
                            <th class="text-center">Số lượng</th>
                            <th class="text-end">Đơn giá</th>
                            <th class="text-end">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in orderDetails)
                        {
                            <tr>
                                <td>@item.Product.TenSp</td>
                                <td class="text-center">@item.Quantity</td>
                                <td class="text-end">@item.Price.ToString("N0") ₫</td>
                                <td class="text-end fw-semibold">
                                    @(item.Quantity* item.Price).ToString("N0") ₫
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>

    <!-- Button -->
    <div class="mt-3">
        <a href="javascript:history.back()" class="btn btn-outline-secondary">
            <i class="fa fa-arrow-left"></i> Quay lại
        </a>
    </div>

</div>